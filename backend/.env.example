# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/bookloop
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/bookloop
MONGO_URI=mongodb://127.0.0.1:27017/bookloop

# JWT Secret Key for Authentication
JWT_SECRET=bookloop_jwt_secret_key_2026_secure
